# The shell works without Supabase. Copy to .env.local when connecting a project.
# Local URL: http://127.0.0.1:54321 (after starting Supabase).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Only public project configuration belongs in NEXT_PUBLIC_* variables.
# Do not put a secret/service-role key here. The foundation does not need one.

# Optional, server-only: set both locally to enable the monthly AI explanation.
# Select a Responses API model supporting structured text output. Never use NEXT_PUBLIC_*.
OPENAI_API_KEY=
OPENAI_MODEL=
